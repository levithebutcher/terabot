# Telegram Bot Credentials (Get API_ID and API_HASH from https://my.telegram.org/apps)
# Get BOT_TOKEN from @BotFather on Telegram
BOT_TOKEN=123456789:ABCDefghIJKlmNoPQRsTUVwxyZ
API_ID=12345678
API_HASH=0123456789abcdef0123456789abcdef

# Telegram Admin IDs (comma-separated integer IDs)
ADMIN_IDS=123456789

# Access Control: comma-separated user IDs allowed to use the bot
# Defaults to ADMIN_IDS if left blank
ALLOWED_USERS=

# Optional: Private channel ID for backup storage/caching (e.g. -1001234567890)
# If not set, instant caching is disabled and files are uploaded directly to the user.
PRIVATE_CHAT_ID=

# TeraBox Credentials (REQUIRED for full direct link extraction)
# In browser DevTools -> Application/Storage -> Cookies -> copy value of 'ndus' and 'lang'
# Format: ndus=YOUR_NDUS_TOKEN; lang=en
TERABOX_COOKIE=ndus=your_ndus_token_here; lang=en

# Performance & Concurrency Settings
DOWNLOAD_STREAMS=6
MAX_FILE_SIZE_MB=2000
MAX_CONCURRENT_DOWNLOADS=1
USER_RATE_LIMIT_SECONDS=30
DOWNLOAD_DIR=downloads

# Optional Fallback Resolver API (e.g., custom gateway or Cloudflare worker)
FALLBACK_API_URL=
FALLBACK_API_KEY=
